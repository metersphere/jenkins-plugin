<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="MeterSphere API Endpoint" field="msEndpoint">
        <f:textbox/>
    </f:entry>
    <f:entry title="MeterSphere API AccessKey" field="msAccessKey">
        <f:textbox/>
    </f:entry>
    <f:entry title="MeterSphere API SecretKey" field="msSecretKey">
        <f:textbox/>
    </f:entry>
    <f:validateButton
            title="验证账户" progress="验证中..."
            method="checkAccount" with="msAccessKey,msSecretKey,msEndpoint"/>

    <f:entry title="组织名称" field="organizationId">
        <f:select id="selectOrganizationOption" onchange="handleSelectOrganizationChange()" />
    </f:entry>
    <f:entry title="输入项目名称" field="projectName">
         <f:textbox id="selectProjectOption" onblur="handleSelectProjectChange()"/>
    </f:entry>
    <f:entry title="输入测试计划(组)名称" field="testPlanName">
        <f:textbox/>
    </f:entry>
    <script>
        async function handleSelectOrganizationChange() {
            const crumbValue = document.querySelector('head').getAttribute('data-crumb-value')

            const selectElement = document.querySelector("[id='selectOrganizationOption']");
            const selectedValue = selectElement.value;
            const url = '${rootURL}/descriptorByName/io.metersphere.v3.MeterSphereBuilder/checkSelectOrganizationOption';
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Jenkins-Crumb': crumbValue
                },
                body: 'value=' + encodeURIComponent(selectedValue)
            });
            console.log(res);
        }

        async function handleSelectProjectChange() {
            const crumbValue = document.querySelector('head').getAttribute('data-crumb-value')
            const selectElement = document.querySelector("[id='selectProjectOption']");
            const selectedValue = selectElement.value;
            console.log(selectedValue);
            const url = '${rootURL}/descriptorByName/io.metersphere.v3.MeterSphereBuilder/checkSelectProjectOption';
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'Jenkins-Crumb': crumbValue
                },
                body: 'value=' + encodeURIComponent(selectedValue)
            });
            console.log(res);
        }
    </script>
</j:jelly>
